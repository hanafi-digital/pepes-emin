---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import FeaturedMenu from '../components/FeaturedMenu.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import OpenStatusBadge from '../components/OpenStatusBadge.astro';
import RestaurantJsonLd from '../components/RestaurantJsonLd.astro';
import LazyEmbed from '../components/LazyEmbed.astro';
import ContactCta from '../components/ContactCta.astro';
import { restaurant } from '../data/restaurant';

// Built from the restaurant's name + researched address, not an official
// Google Business Profile link (that's still unconfirmed — see
// docs/pepes-emin/research/adhoc-web-research-2026-09-06.md, workspace
// docs). The Walahar area has more than one similarly-named restaurant, so
// this query is deliberately specific (full name + street number) to avoid
// resolving to the wrong one. TODO(owner): replace with an official Google
// Maps share link once confirmed, and verify the pin actually shows this
// restaurant, not a nearby competitor.
const mapQuery = [
  restaurant.name,
  restaurant.address.street,
  restaurant.address.village,
  restaurant.address.district,
  restaurant.address.city,
]
  .filter(Boolean)
  .join(', ');
const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
---

<BaseLayout
  title={restaurant.name}
  description="RM Pepes Jambal H. Emin adalah rumah makan Sunda di Walahar, Karawang, yang menyajikan pepes jambal, pepes ayam, ayam bakar, dan sate sapi."
  canonicalPath="/"
  hasStickyContact={Boolean(restaurant.googleMapsDirectionsUrl || restaurant.whatsapp)}
>
  <RestaurantJsonLd slot="head" />
  <Hero>
    <OpenStatusBadge slot="status" />
  </Hero>
  <About />
  <FeaturedMenu />
  <Reviews />
  <Location>
    <LazyEmbed
      slot="map"
      src={mapEmbedSrc}
      title={`Peta lokasi ${restaurant.name}`}
      label="Buka peta di Google Maps"
    />
  </Location>
  <ContactCta variant="sticky" />
</BaseLayout>
