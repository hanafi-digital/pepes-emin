---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceList from '../components/PriceList.astro';
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';
import { menu } from '../data/menu';
import heroPlaceholder from '../assets/hero-placeholder.jpg';
import { absoluteUrl } from '../lib/url';

const categoriesWithItems = menu.filter((category) => category.items.length > 0);
const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: absoluteUrl(Astro.site, '/') },
    { '@type': 'ListItem', position: 2, name: 'Menu', item: absoluteUrl(Astro.site, '/menu') },
  ],
};
---

<BaseLayout
  title={`Daftar harga lengkap — ${restaurant.name}`}
  description="Daftar harga lengkap pepes jambal, pepes ayam, ayam bakar, dan menu lainnya di RM Pepes Jambal H. Emin, Walahar, Karawang."
  canonicalPath="/menu"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    is:inline
  />

  <section class="section container">
    <h1>Daftar harga lengkap</h1>

    {
      categoriesWithItems.length > 0 && (
        <nav aria-label="Kategori menu" class="menu-nav">
          {categoriesWithItems.map((category) => (
            <a href={`#${category.name.toLowerCase().replace(/\s+/g, '-')}`}>{category.name}</a>
          ))}
        </nav>
      )
    }
  </section>

  <Image
    src={heroPlaceholder}
    alt={`Placeholder foto ${restaurant.name} — menunggu foto asli dari pemilik`}
    width={1600}
    height={1200}
    loading="lazy"
  />

  <section class="section container">
    <PriceList categories={menu} headingLevel="h2" />

    <p class="menu-page__disclaimer">Harga dapat berubah.</p>

    <div class="menu-page__actions">
      <a href={withBase('/')}>Kembali ke beranda</a>
      {
        hasDirections && (
          <a
            href={restaurant.googleMapsDirectionsUrl!}
            target="_blank"
            rel="noopener noreferrer"
          >
            Arah ke lokasi
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .menu-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }

  .menu-page__disclaimer {
    margin-top: var(--sp-4);
    font-size: var(--fs-100);
  }

  .menu-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-top: var(--sp-3);
  }
</style>
