---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCard from '../components/MenuCard.astro';
import Button from '../components/Button.astro';
import { withBase, absoluteUrl } from '../lib/url';
import { restaurant } from '../data/restaurant';
import { menu } from '../data/menu';
import ContactCta from '../components/ContactCta.astro';

const categoriesWithItems = menu.filter((category) => category.items.length > 0);
const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: absoluteUrl(Astro.site, '/') },
    { '@type': 'ListItem', position: 2, name: 'Menu', item: absoluteUrl(Astro.site, '/menu') },
  ],
};
---

<BaseLayout
  title={`Daftar harga lengkap — ${restaurant.name}`}
  description="Daftar harga lengkap pepes jambal, pepes ayam, ayam bakar, dan menu lainnya di RM Pepes Jambal H. Emin, Walahar, Karawang."
  canonicalPath="/menu"
  hasStickyContact={Boolean(restaurant.googleMapsDirectionsUrl || restaurant.whatsapp)}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    is:inline
  />

  <div class="p-4">
    <h1 class="text-xl font-bold tracking-tight text-gray-900">Daftar harga lengkap</h1>

    {
      categoriesWithItems.length > 0 && (
        <nav aria-label="Kategori menu" class="mt-3 flex flex-wrap gap-3">
          {categoriesWithItems.map((category) => (
            <a
              href={`#${category.name.toLowerCase().replace(/\s+/g, '-')}`}
              class="text-sm font-medium text-emerald-600"
            >
              {category.name}
            </a>
          ))}
        </nav>
      )
    }

    {
      categoriesWithItems.map((category) => (
        <div id={category.name.toLowerCase().replace(/\s+/g, '-')} class="mt-6">
          <h2 class="mb-3 text-base font-semibold text-gray-900">{category.name}</h2>
          {category.items.map((item) => <MenuCard item={item} />)}
        </div>
      ))
    }

    <p class="mt-4 mb-3 text-sm text-gray-500">Harga dapat berubah.</p>

    <div class="flex flex-wrap gap-3">
      <Button href={withBase('/')} variant="secondary">Kembali ke beranda</Button>
      {
        hasDirections && (
          <Button
            href={restaurant.googleMapsDirectionsUrl!}
            target="_blank"
            rel="noopener noreferrer"
          >
            Arah ke lokasi
          </Button>
        )
      }
    </div>
  </div>

  <ContactCta variant="sticky" />
</BaseLayout>
