---
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCard from '../components/MenuCard.astro';
import Button from '../components/Button.astro';
import { withBase, absoluteUrl } from '../lib/url';
import { restaurant } from '../data/restaurant';
import { menu } from '../data/menu';
import ContactCta from '../components/ContactCta.astro';

const categoriesWithItems = menu.filter((category) => category.items.length > 0);
const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: absoluteUrl(Astro.site, '/') },
    { '@type': 'ListItem', position: 2, name: 'Menu', item: absoluteUrl(Astro.site, '/menu') },
  ],
};
---

<BaseLayout
  title={`Daftar Menu & Harga Lengkap — ${restaurant.name}`}
  description="Daftar menu dan harga lengkap pepes jambal, pepes ayam, ikan bakar, sate maranggi, dan aneka masakan Sunda di RM Pepes Jambal H. Emin, Walahar, Karawang."
  canonicalPath="/menu"
  hasStickyContact={Boolean(restaurant.googleMapsDirectionsUrl || restaurant.whatsapp)}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    is:inline
  />

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-14 lg:px-8">
    <!-- Header Section -->
    <div class="border-b border-stone-200/80 pb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
        <span>Katalog Kuliner Sunda</span>
      </div>
      <h1 class="mt-3 text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-stone-900">
        Daftar Menu &amp; Harga Lengkap
      </h1>
      <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-2xl leading-relaxed">
        Seluruh olahan disajikan dengan resep bumbu khas Sunda dan bahan segar setiap hari. Harga tercantum adalah harga resmi rumah makan.
      </p>

      <!-- Category Filter Pills -->
      {
        categoriesWithItems.length > 0 && (
          <nav aria-label="Kategori menu" class="mt-6 flex flex-wrap gap-2.5">
            {categoriesWithItems.map((category) => (
              <a
                href={`#${category.name.toLowerCase().replace(/\s+/g, '-')}`}
                class="rounded-full border border-stone-200/90 bg-white px-4 py-1.5 text-xs font-bold text-stone-700 shadow-2xs transition-all hover:border-emerald-700 hover:bg-emerald-50 hover:text-emerald-900 active:scale-95"
              >
                {category.name}
              </a>
            ))}
          </nav>
        )
      }
    </div>

    <!-- Category Sections -->
    <div class="mt-10 flex flex-col gap-14">
      {
        categoriesWithItems.map((category) => (
          <section id={category.name.toLowerCase().replace(/\s+/g, '-')} class="scroll-mt-24">
            <div class="flex items-center gap-3 border-b border-stone-200/80 pb-3.5 mb-6">
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-700"></span>
              <h2 class="text-xl sm:text-2xl font-black text-stone-900">{category.name}</h2>
              <span class="text-xs text-stone-400 font-semibold">({category.items.length} pilihan)</span>
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
              {category.items.map((item) => (
                <MenuCard item={item} categoryName={category.name} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <!-- Note & Action Bottom Bar -->
    <div class="mt-14 rounded-3xl border border-stone-200/80 bg-white/90 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <span class="font-black text-stone-900 text-sm sm:text-base">Catatan Kunjungan &amp; Pemesanan:</span>
          <p class="mt-1 text-xs sm:text-sm text-stone-500 max-w-xl leading-relaxed">
            Harga dan ketersediaan menu dapat berubah sewaktu-waktu. Untuk rombongan besar atau memastikan ketersediaan pepes jambal jumbo, silakan datang lebih awal atau hubungi kami sebelum perjalanan.
          </p>
        </div>

        <div class="flex flex-wrap gap-3 shrink-0">
          <Button href={withBase('/')} variant="secondary">
            &larr; Kembali ke Beranda
          </Button>
          {
            hasDirections && (
              <Button
                href={restaurant.googleMapsDirectionsUrl!}
                target="_blank"
                rel="noopener noreferrer"
              >
                Arah ke Lokasi
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </div>

  <ContactCta variant="sticky" />
</BaseLayout>
