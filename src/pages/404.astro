---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';
---

<BaseLayout
  title={`Halaman tidak ditemukan — ${restaurant.name}`}
  description="Halaman yang Anda cari tidak ditemukan."
  canonicalPath="/404"
  noindex
>
  <section class="flex flex-col gap-4 p-4">
    <h1 class="text-xl font-bold tracking-tight text-gray-900">Halaman tidak ditemukan</h1>
    <p class="text-sm text-gray-500">
      Halaman yang Anda cari tidak ada. Coba kembali ke beranda atau lihat daftar harga
      lengkap kami.
    </p>
    <p class="flex flex-col items-start gap-2">
      <a class="text-sm font-medium text-emerald-600 underline underline-offset-2" href={withBase('/')}>
        Kembali ke beranda
      </a>
      <a class="text-sm font-medium text-emerald-600 underline underline-offset-2" href={withBase('/menu')}>
        Lihat menu
      </a>
    </p>
  </section>
</BaseLayout>
