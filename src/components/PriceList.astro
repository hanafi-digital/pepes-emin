---
import type { MenuCategory } from '../data/types';
import { formatIdr } from '../lib/format';

interface Props {
  categories: MenuCategory[];
  featuredOnly?: boolean;
}

const { categories, featuredOnly = false } = Astro.props;

const visibleCategories = categories
  .map((category) => ({
    ...category,
    items: featuredOnly
      ? category.items.filter((item) => item.isFeatured)
      : category.items,
  }))
  .filter((category) => category.items.length > 0);
---

<div class="price-list">
  {
    visibleCategories.map((category) => (
      <div class="price-list__category">
        <h3>{category.name}</h3>
        <dl>
          {category.items.map((item) => (
            <div class="price-row">
              <dt>
                {item.name}
                {item.description && (
                  <span class="price-row__description">{item.description}</span>
                )}
              </dt>
              <span class="price-row__dots" aria-hidden="true" />
              <dd>
                {item.isAvailable ? formatIdr(item.priceIdr) : 'Sementara tidak tersedia'}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    ))
  }
</div>

<style>
  .price-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .price-list__category dl {
    margin: var(--sp-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
  }

  .price-row dt {
    flex: 0 1 auto;
    font-family: var(--font-display);
  }

  .price-row__description {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-100);
    color: var(--ink);
  }

  .price-row__dots {
    flex: 1 1 auto;
    border-bottom: 1px dotted var(--rule);
    transform: translateY(-0.3em);
    min-width: var(--sp-4);
  }

  .price-row dd {
    flex: 0 0 auto;
    margin: 0;
    color: var(--sambal);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (min-width: 960px) {
    .price-list {
      columns: 2;
      column-gap: var(--sp-7);
    }

    .price-list__category {
      break-inside: avoid;
    }
  }
</style>
