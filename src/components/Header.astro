---
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';

const navItems = [
  { label: 'Tentang Kami', href: withBase('/#tentang') },
  { label: 'Menu Favorit', href: withBase('/#menu') },
  { label: 'Daftar Menu', href: withBase('/menu') },
  { label: 'Kata Pelanggan', href: withBase('/#ulasan') },
  { label: 'Lokasi & Jam', href: withBase('/#lokasi') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isActive(href: string): boolean {
  if (href.includes('#')) {
    return false;
  }
  const hrefPath = href.replace(/\/$/, '');
  return hrefPath !== '' && hrefPath === currentPath;
}
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-white/90 shadow-xs backdrop-blur-md transition-all">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a href={withBase('/')} class="group flex items-center gap-3">
      <div class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-800 to-emerald-950 text-white shadow-md shadow-emerald-900/15 transition-transform duration-300 group-hover:scale-105">
        <svg class="h-5 w-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
          <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
        </svg>
      </div>
      <div>
        <span class="block text-base sm:text-lg font-extrabold tracking-tight text-stone-900 transition-colors group-hover:text-emerald-800">
          RM Pepes Jambal <span class="text-emerald-800">H. Emin</span>
        </span>
        <span class="flex items-center gap-1.5 text-[11px] font-medium text-stone-500">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
          Khas Walahar, Karawang
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav aria-label="Navigasi utama" class="hidden md:flex items-center gap-1 lg:gap-1.5">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-600 transition-all hover:bg-emerald-50 hover:text-emerald-900 aria-[current=page]:bg-emerald-800 aria-[current=page]:text-white aria-[current=page]:shadow-xs"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Header Quick Actions -->
    <div class="hidden sm:flex items-center gap-3">
      {restaurant.googleMapsDirectionsUrl && (
        <a
          href={restaurant.googleMapsDirectionsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-800 to-emerald-900 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-emerald-900/20 transition-all hover:from-emerald-700 hover:to-emerald-800 active:scale-95"
        >
          <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          Arah Lokasi
        </a>
      )}
    </div>
  </div>

  <!-- Mobile Sub-Nav Strip -->
  <div class="flex md:hidden border-t border-stone-200/50 bg-white/95 px-4 py-2 overflow-x-auto no-scrollbar gap-2">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class="shrink-0 rounded-full px-3.5 py-1 text-xs font-semibold text-stone-700 border border-stone-200 bg-[#FAF7F2] transition-colors hover:bg-emerald-50 hover:text-emerald-900 aria-[current=page]:bg-emerald-800 aria-[current=page]:text-white aria-[current=page]:border-emerald-800"
        >
          {item.label}
        </a>
      ))
    }
  </div>
</header>
