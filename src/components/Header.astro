---
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';

const navItems = [
  { label: 'Tentang', href: withBase('/#tentang') },
  { label: 'Menu', href: withBase('/menu') },
  { label: 'Ulasan', href: withBase('/#ulasan') },
  { label: 'Lokasi', href: withBase('/#lokasi') },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');

function isActive(href: string): boolean {
  // In-page anchors (e.g. "/#tentang") are same-page jumps, not distinct
  // routes, and should never be marked as the current page.
  if (href.includes('#')) {
    return false;
  }
  const hrefPath = href.replace(/\/$/, '');
  return hrefPath !== '' && hrefPath === currentPath;
}
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/80 px-4 py-3 backdrop-blur-md">
  <div class="flex items-center justify-between gap-3">
    <a href={withBase('/')} class="text-lg font-bold tracking-tight text-gray-900">
      {restaurant.name}
    </a>
    <nav
      aria-label="Navigasi utama"
      class="flex gap-4 overflow-x-auto [-webkit-overflow-scrolling:touch]"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="whitespace-nowrap text-sm font-medium text-gray-500 aria-[current=page]:text-emerald-600 aria-[current=page]:underline aria-[current=page]:underline-offset-4"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
