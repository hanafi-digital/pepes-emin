---
// Server-rendered output is deliberately neutral: this page may be served
// from a cache long after build time, so we can't compute "open now" at
// build time without risking a stale, wrong answer. The real status is
// computed client-side, in Asia/Jakarta time, once the page loads.
---

<div class="inline-flex items-center gap-2 rounded-full border border-stone-200/90 bg-white/95 px-3.5 py-1.5 text-xs font-semibold text-stone-700 shadow-2xs backdrop-blur-xs transition-colors">
  <span
    class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-stone-400 transition-colors"
    data-status-dot
  ></span>
  <span
    class="font-medium text-stone-700 data-[open=true]:text-emerald-800 data-[open=true]:font-semibold"
    data-open-status
  >
    Lihat jam buka
  </span>
</div>

<script>
  import { isOpenNow, jakartaDayAndMinutes } from '../lib/opening-hours';
  import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';

  const badges = document.querySelectorAll<HTMLElement>('[data-open-status]');
  if (badges.length > 0) {
    const result = isOpenNow(openingHours, new Date());

    let text: string;
    if (!result.hasSchedule) {
      text = 'Jam buka belum tersedia';
    } else if (result.open && result.changeAt) {
      text = `Buka sekarang • Tutup pukul ${result.changeAt.time}`;
    } else if (result.changeAt) {
      const dayLabel = DAY_LABEL_ID[result.changeAt.day];
      text = `Tutup • Buka lagi ${dayLabel} pukul ${result.changeAt.time}`;
    } else {
      text = 'Tutup';
    }

    badges.forEach((el) => {
      el.textContent = text;
      el.dataset.open = String(result.open);
      const dot = el.parentElement?.querySelector<HTMLElement>('[data-status-dot]');
      if (dot) {
        if (result.open) {
          dot.className = 'inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-emerald-500 animate-pulse';
        } else {
          dot.className = 'inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-rose-500';
        }
      }
    });
  }

  const { day } = jakartaDayAndMinutes(new Date());
  const row = document.querySelector<HTMLElement>(`[data-hours-table] tr[data-day="${day}"]`);
  row?.setAttribute('data-today', 'true');
</script>
