---
import type { MenuItem } from '../data/types';
import { formatIdr } from '../lib/format';

interface Props {
  item: MenuItem;
  categoryName?: string;
}

const { item, categoryName } = Astro.props;

function getCategoryConfig(name: string, category?: string): { label: string; icon: string; badgeClass: string } {
  const lower = (category || name).toLowerCase();
  if (lower.includes('pepes')) {
    return {
      label: 'Pepes Khas',
      icon: '🍃',
      badgeClass: 'bg-emerald-50 text-emerald-900 border-emerald-200/80',
    };
  }
  if (lower.includes('ayam') || lower.includes('bebek') || lower.includes('daging') || lower.includes('sate')) {
    return {
      label: 'Ayam & Sate',
      icon: '🍗',
      badgeClass: 'bg-amber-50 text-amber-900 border-amber-200/80',
    };
  }
  if (lower.includes('ikan') || lower.includes('gurame') || lower.includes('mas')) {
    return {
      label: 'Olahan Ikan',
      icon: '🐟',
      badgeClass: 'bg-cyan-50 text-cyan-900 border-cyan-200/80',
    };
  }
  if (lower.includes('sayur') || lower.includes('sop') || lower.includes('lalap') || lower.includes('sambal')) {
    return {
      label: 'Sayur & Sambal',
      icon: '🌶️',
      badgeClass: 'bg-lime-50 text-lime-900 border-lime-200/80',
    };
  }
  if (lower.includes('minuman') || lower.includes('jus') || lower.includes('es') || lower.includes('teh')) {
    return {
      label: 'Minuman Segar',
      icon: '🥤',
      badgeClass: 'bg-blue-50 text-blue-900 border-blue-200/80',
    };
  }
  return {
    label: categoryName || 'Menu Pilihan',
    icon: '🍽️',
    badgeClass: 'bg-stone-50 text-stone-800 border-stone-200',
  };
}

const config = getCategoryConfig(item.name, categoryName);
---

<div class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white p-6 shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-700/50 hover:shadow-xl">
  <div>
    <!-- Top Row: Category Icon & Badges -->
    <div class="flex items-center justify-between gap-2">
      <span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold ${config.badgeClass}`}>
        <span>{config.icon}</span>
        <span>{config.label}</span>
      </span>

      {
        item.isFeatured && (
          <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-2.5 py-0.5 text-[11px] font-extrabold text-white shadow-xs">
            ★ Favorit
          </span>
        )
      }
    </div>

    <!-- Dish Name -->
    <div class="mt-4">
      <h3 class="text-lg font-bold text-stone-900 group-hover:text-emerald-900 transition-colors">
        {item.name}
      </h3>
      {item.description && (
        <p class="mt-1 text-xs sm:text-sm text-stone-500 leading-snug">
          {item.description}
        </p>
      )}
    </div>
  </div>

  <!-- Price & Status Footer -->
  <div class="mt-6 flex items-baseline justify-between border-t border-stone-100 pt-4">
    <div>
      <span class="block text-[11px] font-medium text-stone-400 uppercase tracking-wider">Harga Resmi</span>
      <span class="text-lg sm:text-xl font-black text-emerald-800 tabular-nums">
        {item.isAvailable ? formatIdr(item.priceIdr) : 'Habis'}
      </span>
    </div>

    <span class="inline-flex items-center gap-1 text-xs font-semibold text-stone-500 group-hover:text-emerald-800 transition-colors">
      <span>Tersedia</span>
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
    </span>
  </div>
</div>
