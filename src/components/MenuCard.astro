---
import { Image } from 'astro:assets';
import type { MenuItem } from '../data/types';
import { formatIdr } from '../lib/format';

import pepesJambalImg from '../assets/hero-placeholder.jpg';
import pepesAyamImg from '../assets/pepes-ayam.jpg';
import sateMaranggiImg from '../assets/sate-maranggi.jpg';
import ikanBakarImg from '../assets/ikan-bakar.jpg';
import bakakakAyamImg from '../assets/bakakak-ayam.jpg';
import sayurAsemImg from '../assets/sayur-asem.jpg';
import minumanSegarImg from '../assets/minuman-segar.jpg';

interface Props {
  item: MenuItem;
  categoryName?: string;
}

const { item, categoryName } = Astro.props;

// Match items to actual high-resolution dish photography
const dishImages: Record<string, ImageMetadata> = {
  'Pepes Jambal': pepesJambalImg,
  'Pepes Ayam': pepesAyamImg,
  'Sate Maranggi': sateMaranggiImg,
  'Ikan Bakar': ikanBakarImg,
  'Bakakak (Ayam)': bakakakAyamImg,
  'Sayur Asem': sayurAsemImg,
  'Es Jeruk': minumanSegarImg,
  'Es Kelapa': minumanSegarImg,
  'Es Teh Manis': minumanSegarImg,
  'Lalap': sayurAsemImg,
  'Sambel': sayurAsemImg,
};

const photo = dishImages[item.name] || null;

function getCategoryConfig(name: string, category?: string): { label: string; icon: string; badgeClass: string } {
  const lower = (category || name).toLowerCase();
  if (lower.includes('pepes')) {
    return {
      label: 'Pepes Khas',
      icon: '🍃',
      badgeClass: 'bg-emerald-50 text-emerald-900 border-emerald-200/80',
    };
  }
  if (lower.includes('ayam') || lower.includes('bebek') || lower.includes('daging') || lower.includes('sate')) {
    return {
      label: 'Ayam & Sate',
      icon: '🍗',
      badgeClass: 'bg-amber-50 text-amber-900 border-amber-200/80',
    };
  }
  if (lower.includes('ikan') || lower.includes('gurame') || lower.includes('mas')) {
    return {
      label: 'Olahan Ikan',
      icon: '🐟',
      badgeClass: 'bg-cyan-50 text-cyan-900 border-cyan-200/80',
    };
  }
  if (lower.includes('sayur') || lower.includes('sop') || lower.includes('lalap') || lower.includes('sambal')) {
    return {
      label: 'Sayur & Sambal',
      icon: '🌶️',
      badgeClass: 'bg-lime-50 text-lime-900 border-lime-200/80',
    };
  }
  if (lower.includes('minuman') || lower.includes('jus') || lower.includes('es') || lower.includes('teh')) {
    return {
      label: 'Minuman Segar',
      icon: '🥤',
      badgeClass: 'bg-blue-50 text-blue-900 border-blue-200/80',
    };
  }
  return {
    label: categoryName || 'Menu Pilihan',
    icon: '🍽️',
    badgeClass: 'bg-stone-50 text-stone-800 border-stone-200',
  };
}

const config = getCategoryConfig(item.name, categoryName);
---

<div class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-xs transition-all duration-300 hover:-translate-y-1.5 hover:border-emerald-700/50 hover:shadow-xl">
  <div>
    {
      photo ? (
        <div class="relative aspect-[16/11] w-full overflow-hidden bg-stone-100">
          <Image
            src={photo}
            alt={`Foto sajian ${item.name} RM Pepes Jambal H. Emin`}
            width={600}
            height={420}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

          <!-- Top Badge Overlay -->
          <div class="absolute top-3 left-3 flex items-center gap-1.5">
            <span class="inline-flex items-center gap-1 rounded-full bg-black/60 px-2.5 py-0.5 text-[11px] font-bold text-white backdrop-blur-xs">
              <span>{config.icon}</span>
              <span>{config.label}</span>
            </span>
          </div>

          {item.isFeatured && (
            <div class="absolute top-3 right-3">
              <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-2.5 py-0.5 text-[11px] font-black text-white shadow-md">
                ★ Terfavorit
              </span>
            </div>
          )}
        </div>
      ) : (
        <div class="p-6 pb-0 flex items-center justify-between gap-2">
          <span class={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-bold ${config.badgeClass}`}>
            <span>{config.icon}</span>
            <span>{config.label}</span>
          </span>
          {item.isFeatured && (
            <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-2.5 py-0.5 text-[11px] font-black text-white shadow-xs">
              ★ Terfavorit
            </span>
          )}
        </div>
      )
    }

    <!-- Content Details -->
    <div class="p-5 sm:p-6">
      <h3 class="text-base sm:text-lg font-extrabold text-stone-900 group-hover:text-emerald-900 transition-colors">
        {item.name}
      </h3>
      {item.description && (
        <p class="mt-1 text-xs sm:text-sm text-stone-500 leading-snug">
          {item.description}
        </p>
      )}

      <!-- Price & Status Footer -->
      <div class="mt-4 flex items-baseline justify-between border-t border-stone-100 pt-3">
        <div>
          <span class="block text-[10px] font-bold text-stone-400 uppercase tracking-wider">Harga Resmi</span>
          <span class="text-lg sm:text-xl font-black text-emerald-800 tabular-nums">
            {item.isAvailable ? formatIdr(item.priceIdr) : 'Habis'}
          </span>
        </div>

        <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-800">
          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
          <span>Tersedia</span>
        </span>
      </div>
    </div>
  </div>
</div>
