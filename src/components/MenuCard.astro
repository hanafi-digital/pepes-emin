---
import { Image } from 'astro:assets';
import type { MenuItem } from '../data/types';
import { formatIdr } from '../lib/format';
import placeholderImage from '../assets/hero-placeholder.jpg';

interface Props {
  item: MenuItem;
}

const { item } = Astro.props;
---

<div class="mb-3 flex flex-row gap-3 overflow-hidden rounded-xl border border-gray-100 bg-white p-3 shadow-sm">
  <Image
    src={placeholderImage}
    alt={`Placeholder foto ${item.name} — menunggu foto asli dari pemilik`}
    width={96}
    height={96}
    loading="lazy"
    class="h-24 w-24 flex-shrink-0 rounded-lg object-cover"
  />
  <div class="flex min-w-0 flex-1 flex-col justify-center gap-1">
    <div class="flex items-start justify-between gap-2">
      <span class="text-base font-semibold text-gray-900">{item.name}</span>
      {
        item.isFeatured && (
          <span class="inline-block flex-shrink-0 rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-800">
            Favorit
          </span>
        )
      }
    </div>
    {item.description && <p class="text-sm leading-snug text-gray-500">{item.description}</p>}
    <p class="text-base font-bold text-emerald-600">
      {item.isAvailable ? formatIdr(item.priceIdr) : 'Sementara tidak tersedia'}
    </p>
  </div>
</div>
