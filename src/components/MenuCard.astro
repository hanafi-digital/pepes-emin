---
import type { MenuItem } from '../data/types';
import { formatIdr } from '../lib/format';

interface Props {
  item: MenuItem;
  categoryName?: string;
}

const { item, categoryName } = Astro.props;

// Determine category icon or accent color
function getCategoryBadge(name: string, category?: string): { label: string; color: string } {
  const lower = (category || name).toLowerCase();
  if (lower.includes('pepes')) {
    return { label: 'Pepes Khas', color: 'bg-emerald-100 text-emerald-900 border-emerald-200' };
  }
  if (lower.includes('ayam') || lower.includes('bebek') || lower.includes('daging') || lower.includes('sate')) {
    return { label: 'Ayam & Sate', color: 'bg-amber-100 text-amber-900 border-amber-200' };
  }
  if (lower.includes('ikan')) {
    return { label: 'Olahan Ikan', color: 'bg-cyan-100 text-cyan-900 border-cyan-200' };
  }
  if (lower.includes('sayur') || lower.includes('sop') || lower.includes('lalap') || lower.includes('sambal')) {
    return { label: 'Sayur & Sambal', color: 'bg-lime-100 text-lime-900 border-lime-200' };
  }
  if (lower.includes('minuman') || lower.includes('jus') || lower.includes('es') || lower.includes('teh')) {
    return { label: 'Minuman Segar', color: 'bg-blue-100 text-blue-900 border-blue-200' };
  }
  return { label: categoryName || 'Menu Pilihan', color: 'bg-stone-100 text-stone-800 border-stone-200' };
}

const badge = getCategoryBadge(item.name, categoryName);
---

<div class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-stone-200/80 bg-white p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-emerald-800/40 hover:shadow-md">
  <div>
    <!-- Badges Row -->
    <div class="flex items-center justify-between gap-2">
      <span class={`inline-block rounded-full border px-2.5 py-0.5 text-[11px] font-semibold ${badge.color}`}>
        {badge.label}
      </span>
      {
        item.isFeatured && (
          <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/15 border border-amber-400/40 px-2.5 py-0.5 text-[11px] font-bold text-amber-800">
            ★ Terfavorit
          </span>
        )
      }
    </div>

    <!-- Title & Description -->
    <div class="mt-3">
      <h3 class="text-base sm:text-lg font-bold text-stone-900 group-hover:text-emerald-900 transition-colors">
        {item.name}
      </h3>
      {item.description && (
        <p class="mt-1 text-xs sm:text-sm text-stone-500 leading-snug">
          {item.description}
        </p>
      )}
    </div>
  </div>

  <!-- Price & Status Footer -->
  <div class="mt-4 flex items-baseline justify-between border-t border-stone-100 pt-3">
    <span class="text-xs text-stone-400 font-medium">Harga</span>
    <span class="text-base sm:text-lg font-extrabold text-emerald-800 tabular-nums">
      {item.isAvailable ? formatIdr(item.priceIdr) : 'Sementara tidak tersedia'}
    </span>
  </div>
</div>
