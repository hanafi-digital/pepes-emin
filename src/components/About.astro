---
import { restaurant } from '../data/restaurant';
---

<section id="tentang" class="section about">
  <div class="container">
    <h2>Tentang</h2>

    {restaurant.description.map((paragraph) => <p>{paragraph}</p>)}

    {
      restaurant.highlights.length > 0 && (
        <ul class="about__highlights">
          {restaurant.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .about__highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .about__highlights li {
    padding-left: var(--sp-4);
    position: relative;
  }

  .about__highlights li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--rule);
  }
</style>
