---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  target?: '_blank';
  rel?: string;
  class?: string;
}

const { href, variant = 'primary', target, rel, class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-semibold text-sm py-3 px-5 rounded-2xl active:scale-95 transition-all duration-200 text-center cursor-pointer';
const variants = {
  primary: 'bg-emerald-800 hover:bg-emerald-900 text-white shadow-sm shadow-emerald-900/10',
  secondary: 'bg-white hover:bg-stone-100/80 text-stone-800 border border-stone-300/80 shadow-2xs',
};
const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} target={target} rel={rel} class={classes}>
      <slot />
    </a>
  ) : (
    <button type="button" class={classes}>
      <slot />
    </button>
  )
}
