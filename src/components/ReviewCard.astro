---
import type { Review } from '../data/types';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<blockquote class="m-0 rounded-xl border border-gray-100 bg-white p-4 shadow-sm">
  <p class="m-0 text-sm italic text-gray-900">&ldquo;{review.quote}&rdquo;</p>
  <cite class="mt-2 block text-xs not-italic text-gray-500">
    {review.author ? `${review.author} — ${review.source}` : review.source}
  </cite>
</blockquote>
