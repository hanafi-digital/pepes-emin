---
import type { Review } from '../data/types';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<div class="flex flex-col justify-between rounded-2xl border border-stone-200/80 bg-white p-6 shadow-xs transition-transform hover:-translate-y-0.5">
  <div>
    <!-- Star Rating -->
    <div class="flex items-center gap-1 text-amber-400 mb-3" aria-label="Rating 5 dari 5 bintang">
      {Array.from({ length: 5 }).map(() => (
        <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>

    <!-- Quote -->
    <blockquote class="text-sm leading-relaxed text-stone-700 italic">
      &ldquo;{review.quote}&rdquo;
    </blockquote>
  </div>

  <!-- Author Info -->
  <div class="mt-4 flex items-center gap-3 border-t border-stone-100 pt-3 text-xs">
    <div class="flex h-7 w-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 font-bold text-xs">
      {review.author ? review.author.charAt(0).toUpperCase() : 'G'}
    </div>
    <div>
      <span class="block font-bold text-stone-800">
        {review.author || 'Pengunjung Rumah Makan'}
      </span>
      <span class="block text-stone-400 text-[11px]">
        {review.source}
      </span>
    </div>
  </div>
</div>
