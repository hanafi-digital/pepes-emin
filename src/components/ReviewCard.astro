---
import type { Review } from '../data/types';

interface Props {
  review: Review;
}

const { review } = Astro.props;
---

<div class="flex flex-col justify-between rounded-3xl border border-stone-200/80 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-emerald-700/40 hover:shadow-md">
  <div>
    <!-- 5 Star Rating -->
    <div class="flex items-center gap-1 text-amber-400 mb-3" aria-label="Rating 5 dari 5 bintang">
      {Array.from({ length: 5 }).map(() => (
        <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </div>

    <!-- Quote -->
    <blockquote class="text-sm sm:text-base leading-relaxed text-stone-700 italic">
      &ldquo;{review.quote}&rdquo;
    </blockquote>
  </div>

  <!-- Author Info -->
  <div class="mt-6 flex items-center gap-3 border-t border-stone-100 pt-4 text-xs">
    <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-700 to-emerald-900 text-white font-extrabold text-xs shadow-xs">
      {review.author ? review.author.charAt(0).toUpperCase() : 'G'}
    </div>
    <div>
      <span class="block font-bold text-stone-900">
        {review.author || 'Pengunjung Rumah Makan'}
      </span>
      <span class="flex items-center gap-1 text-stone-500 text-[11px]">
        <svg class="h-3 w-3 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        <span>Ulasan Terverifikasi Google</span>
      </span>
    </div>
  </div>
</div>
