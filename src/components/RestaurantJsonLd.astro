---
import { restaurant } from '../data/restaurant';
import { openingHours } from '../data/opening-hours';
import type { DayOfWeek } from '../data/types';
import { absoluteUrl } from '../lib/url';

// schema.org expects English day names regardless of site language.
const SCHEMA_DAY: Record<DayOfWeek, string> = {
  monday: 'Monday',
  tuesday: 'Tuesday',
  wednesday: 'Wednesday',
  thursday: 'Thursday',
  friday: 'Friday',
  saturday: 'Saturday',
  sunday: 'Sunday',
};

const confirmedHours = openingHours.filter((h) => !h.closed && h.opens && h.closes);

// If no day has confirmed hours, omit openingHoursSpecification entirely
// rather than rendering an "always closed" schedule — that would assert
// something false, which is worse than not stating hours at all.
const data: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  description: restaurant.description.join(' '),
  url: absoluteUrl(Astro.site, '/'),
  image: [absoluteUrl(Astro.site, '/og-image.jpg')],
  address: {
    '@type': 'PostalAddress',
    streetAddress: restaurant.address.street ?? undefined,
    addressLocality: 'Karawang',
    addressRegion: 'Jawa Barat',
    postalCode: restaurant.address.postalCode ?? undefined,
    addressCountry: 'ID',
  },
  servesCuisine: restaurant.servesCuisine,
  priceRange: restaurant.priceRange ?? undefined,
  hasMenu: absoluteUrl(Astro.site, '/menu'),
};

if (confirmedHours.length > 0) {
  data.openingHoursSpecification = confirmedHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: SCHEMA_DAY[h.day],
    opens: h.opens,
    closes: h.closes,
  }));
}

if (restaurant.geo) {
  data.geo = {
    '@type': 'GeoCoordinates',
    latitude: restaurant.geo.lat,
    longitude: restaurant.geo.lng,
  };
}

if (restaurant.phone) {
  data.telephone = restaurant.phone;
}

// Never render aggregateRating/review here — that data would have to come
// from ratings collected on this site itself, not copied from Google or any
// third party. See docs/pepes-emin/pid.md (workspace docs) for why.
---

<script type="application/ld+json" set:html={JSON.stringify(data)} is:inline />
