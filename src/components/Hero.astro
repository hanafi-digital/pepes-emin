---
// TODO(owner): replace src/assets/hero-placeholder.jpg with a real photo once
// the restaurant owner provides one (see the hero image entry in the content
// checklist). The current image is a plain placeholder graphic, not a photo.
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';
import Button from './Button.astro';
import heroPlaceholder from '../assets/hero-placeholder.jpg';

const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);
const location = `${restaurant.address.village}, ${restaurant.address.city}`;
---

<section class="relative mx-auto max-w-4xl lg:grid lg:grid-cols-2 lg:items-stretch lg:gap-8 lg:px-4 lg:py-8">
  <div class="relative aspect-[4/3] w-full overflow-hidden lg:aspect-auto lg:rounded-2xl">
    <Image
      src={heroPlaceholder}
      alt={`Placeholder foto ${restaurant.name} — menunggu foto asli dari pemilik`}
      width={1600}
      height={1200}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

    <span class="absolute top-4 left-4 rounded-full bg-amber-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
      Spesialis Pepes Jambal
    </span>

    <div class="absolute right-4 bottom-4 left-4 text-white">
      <h1 class="text-2xl font-bold tracking-tight text-white drop-shadow-sm">
        {restaurant.name}
      </h1>
      <p class="text-sm font-medium text-white/90">{location}</p>
    </div>
  </div>

  <div class="flex flex-col gap-3 p-4 lg:justify-center lg:p-0">
    {restaurant.tagline && <p class="text-sm text-gray-500">{restaurant.tagline}</p>}

    <slot name="status" />

    <div class="flex flex-wrap gap-3">
      <Button href={withBase('/menu')} class="flex-1">Lihat menu</Button>
      {
        hasDirections && (
          <Button
            href={restaurant.googleMapsDirectionsUrl!}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            class="flex-1"
          >
            Arah ke lokasi
          </Button>
        )
      }
    </div>
  </div>
</section>
