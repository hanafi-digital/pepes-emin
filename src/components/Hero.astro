---
// TODO(owner): replace src/assets/hero-placeholder.jpg with a real photo once
// the restaurant owner provides one (see the hero image entry in the content
// checklist). The current image is a plain placeholder graphic, not a photo.
import { Image } from 'astro:assets';
import { withBase } from '../lib/url';
import { restaurant } from '../data/restaurant';
import Button from './Button.astro';
import heroPlaceholder from '../assets/hero-placeholder.jpg';

const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);
const location = `${restaurant.address.village}, ${restaurant.address.city}`;
---

<section class="relative overflow-hidden pt-6 pb-12 sm:pt-10 sm:pb-16 lg:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Left Content Column -->
      <div class="flex flex-col lg:col-span-7">
        <!-- Eyebrow Badge -->
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-amber-300/80 bg-gradient-to-r from-amber-50 to-orange-50 px-4 py-1.5 text-xs font-bold text-amber-900 shadow-2xs">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-600"></span>
          </span>
          <span>Kuliner Otentik Khas Walahar • Karawang</span>
        </div>

        <!-- Main Title -->
        <h1 class="mt-4 text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-stone-900 leading-[1.12]">
          RM Pepes Jambal <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-800 via-emerald-700 to-amber-700">H. Emin</span>
        </h1>

        <!-- Subtitle -->
        <p class="mt-3 text-lg sm:text-xl font-bold text-emerald-950">
          Sensasi Olahan Pepes Ikan Jambal Roti Asli Tepi Bendungan Walahar
        </p>

        <p class="mt-3 text-sm sm:text-base leading-relaxed text-stone-600 max-w-xl">
          Ikan jambal roti gurih pilihan dibalut racikan rempah khas Sunda, dibungkus daun pisang segar dan dikukus perlahan hingga aroma harumnya meresap sempurna sampai ke serat terdalam.
        </p>

        <!-- Status Badge -->
        <div class="mt-5">
          <slot name="status" />
        </div>

        <!-- Action Buttons -->
        <div class="mt-6 flex flex-wrap items-center gap-3 sm:gap-4">
          <Button href={withBase('/menu')} class="w-full sm:w-auto shadow-lg shadow-emerald-900/15">
            <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/>
              <path d="M7 2v20"/>
              <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
            </svg>
            <span>Lihat Daftar Menu</span>
          </Button>

          {hasDirections && (
            <Button
              href={restaurant.googleMapsDirectionsUrl!}
              target="_blank"
              rel="noopener noreferrer"
              variant="secondary"
              class="w-full sm:w-auto"
            >
              <svg class="h-4 w-4 text-emerald-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="3 11 22 2 13 21 11 13 3 11"/>
              </svg>
              <span>Arah ke Lokasi</span>
            </Button>
          )}
        </div>

        <!-- 3 Feature Highlight Cards -->
        <div class="mt-8 grid grid-cols-3 gap-3 sm:gap-4 border-t border-stone-200/80 pt-6">
          <div class="rounded-2xl bg-white/80 p-3 sm:p-4 border border-stone-200/80 shadow-xs transition-all hover:border-emerald-700/40">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 font-bold mb-2">
              🐟
            </div>
            <span class="block text-[11px] text-stone-500 font-medium">Ikan Pilihan</span>
            <span class="block text-xs sm:text-sm font-bold text-stone-900 leading-tight">Jambal Roti Tebal</span>
          </div>

          <div class="rounded-2xl bg-white/80 p-3 sm:p-4 border border-stone-200/80 shadow-xs transition-all hover:border-emerald-700/40">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-100 text-amber-800 font-bold mb-2">
              🍃
            </div>
            <span class="block text-[11px] text-stone-500 font-medium">Aroma Alami</span>
            <span class="block text-xs sm:text-sm font-bold text-stone-900 leading-tight">Kukus Daun Pisang</span>
          </div>

          <div class="rounded-2xl bg-white/80 p-3 sm:p-4 border border-stone-200/80 shadow-xs transition-all hover:border-emerald-700/40">
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-rose-100 text-rose-800 font-bold mb-2">
              🌶️
            </div>
            <span class="block text-[11px] text-stone-500 font-medium">Resep Sunda</span>
            <span class="block text-xs sm:text-sm font-bold text-stone-900 leading-tight">Rempah Bumbu Ulek</span>
          </div>
        </div>
      </div>

      <!-- Right Visual Column (Modern Layered Card) -->
      <div class="lg:col-span-5">
        <div class="relative">
          <!-- Main Hero Image Frame -->
          <div class="group relative overflow-hidden rounded-3xl border-2 border-white/80 bg-stone-900 shadow-2xl shadow-emerald-950/20 aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/5]">
            <Image
              src={heroPlaceholder}
              alt={`Placeholder foto ${restaurant.name} — menunggu foto asli dari pemilik`}
              width={1600}
              height={1200}
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/25 to-transparent"></div>

            <!-- Top Left Badge -->
            <div class="absolute top-4 left-4 rounded-full bg-gradient-to-r from-amber-500 to-orange-500 px-3.5 py-1 text-xs font-bold text-white shadow-md">
              🔥 Spesialis Pepes Jambal
            </div>

            <!-- Top Right Location -->
            <div class="absolute top-4 right-4 rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-stone-800 shadow-md backdrop-blur-xs">
              📍 {location}
            </div>

            <!-- Bottom Card Content -->
            <div class="absolute right-4 bottom-4 left-4 text-white">
              <div class="rounded-2xl bg-black/50 p-4 backdrop-blur-md border border-white/15 shadow-lg">
                <span class="text-xs font-semibold text-amber-300 uppercase tracking-wider">Warisan Kuliner Walahar</span>
                <p class="text-base sm:text-lg font-bold text-white mt-0.5">Pepes Jambal &amp; Aneka Lauk Sunda</p>
                <p class="text-xs text-stone-300 mt-1">Disajikan hangat bersama lalapan segar dan nasi liwet</p>
              </div>
            </div>
          </div>

          <!-- Floating Micro Card 1: Google Rating -->
          <div class="hidden sm:flex absolute -bottom-5 -left-5 items-center gap-3 rounded-2xl border border-stone-200/80 bg-white p-3 shadow-xl backdrop-blur-md animate-bounce-subtle">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-100 text-amber-600 font-bold text-lg">
              ★
            </div>
            <div>
              <div class="flex items-center gap-1">
                <span class="font-extrabold text-sm text-stone-900">4.4 / 5.0</span>
                <span class="text-xs text-amber-500 font-bold">★★★★★</span>
              </div>
              <p class="text-[11px] text-stone-500">1.000+ Ulasan Google Maps</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
