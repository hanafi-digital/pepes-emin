---
import { Image } from 'astro:assets';

interface Props {
  videoId: string;
  title: string;
  posterSrc: ImageMetadata;
  posterAlt: string;
  /** Shown below the video when it belongs to someone else's channel. */
  channelName?: string;
}

const { videoId, title, posterSrc, posterAlt, channelName } = Astro.props;
---

<div class="relative aspect-video overflow-hidden rounded-xl">
  <button
    type="button"
    class="block h-full w-full cursor-pointer border-0 p-0 focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-amber-500"
    data-video-embed
    data-video-id={videoId}
    data-video-title={title}
    aria-label={`Putar video: ${title}`}
  >
    <Image
      src={posterSrc}
      alt={posterAlt}
      width={1280}
      height={720}
      loading="lazy"
      class="h-full w-full object-cover"
    />
    <span
      class="absolute inset-0 flex items-center justify-center bg-black/35 text-3xl text-white"
      aria-hidden="true"
    >
      ▶
    </span>
  </button>

  <noscript>
    <a
      class="absolute inset-0 flex items-center justify-center bg-emerald-800 text-white underline"
      href={`https://www.youtube.com/watch?v=${videoId}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      Tonton video: {title}
    </a>
  </noscript>
</div>

{channelName && <p class="mt-2 text-xs text-gray-500">Video oleh {channelName}</p>}

<script is:inline>
  document.querySelectorAll("[data-video-embed]").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var id = btn.dataset.videoId;
      var f = document.createElement("iframe");
      f.src = "https://www.youtube-nocookie.com/embed/" + id + "?autoplay=1";
      f.title = btn.dataset.videoTitle;
      f.allow = "accelerometer; autoplay; encrypted-media; picture-in-picture";
      f.allowFullscreen = true;
      f.loading = "lazy";
      f.style.cssText = "width:100%;height:100%;border:0";
      btn.replaceWith(f);
    });
  });
</script>
