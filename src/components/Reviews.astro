---
import ReviewCard from './ReviewCard.astro';
import { reviews } from '../data/reviews';
import { restaurant } from '../data/restaurant';

const hasMapsUrl = Boolean(restaurant.googleMapsUrl);
---

<section id="ulasan" class="py-12 sm:py-16 lg:py-24 bg-white/70 border-y border-stone-200/70 backdrop-blur-xs">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
          <span>Kata Pelanggan</span>
        </div>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-stone-900">
          Pengalaman Bersantap di RM H. Emin
        </h2>
        <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-xl leading-relaxed">
          Kesan nyata dari para penikmat kuliner, wisatawan keluarga, dan pelanggan setia yang singgah di Walahar.
        </p>
      </div>

      <!-- Trust Rating Badge -->
      <div class="inline-flex items-center gap-3.5 rounded-3xl border border-stone-200/90 bg-white p-4 shadow-sm">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-500 text-white font-black text-xl shadow-xs">
          ★
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-base font-black text-stone-900">4.4 / 5.0</span>
            <span class="text-xs text-amber-500 font-bold">★★★★★</span>
          </div>
          <p class="text-xs font-semibold text-stone-500">1.000+ Ulasan Google Maps</p>
        </div>
      </div>
    </div>

    <!-- Review Cards Grid -->
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
      {reviews.map((review) => (
        <ReviewCard review={review} />
      ))}
    </div>

    {hasMapsUrl && (
      <div class="mt-10 text-center sm:text-right">
        <a
          class="inline-flex items-center gap-2 rounded-2xl border border-stone-300/80 bg-white px-5 py-3 text-xs sm:text-sm font-bold text-stone-800 shadow-2xs transition-all hover:bg-emerald-50 hover:text-emerald-900 hover:border-emerald-700/50 active:scale-95"
          href={restaurant.googleMapsUrl!}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Baca Semua Ulasan Langsung di Google Maps</span>
          <svg class="h-4 w-4 text-emerald-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
