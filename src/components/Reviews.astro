---
import ReviewCard from './ReviewCard.astro';
import { reviews } from '../data/reviews';
import { restaurant } from '../data/restaurant';

const hasMapsUrl = Boolean(restaurant.googleMapsUrl);
---

<section id="ulasan" class="mx-auto flex max-w-4xl flex-col gap-4 px-4 py-6">
  <h2 class="text-xl font-bold tracking-tight text-gray-900">Kata pelanggan</h2>

  {
    reviews.length > 0 && (
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.map((review) => (
          <ReviewCard review={review} />
        ))}
      </div>
    )
  }

  <div id="google-reviews-embed" class="aspect-video min-h-[200px]" />

  {
    hasMapsUrl && (
      <a
        class="w-fit text-sm font-medium text-emerald-600 underline underline-offset-2 hover:text-emerald-700"
        href={restaurant.googleMapsUrl!}
        target="_blank"
        rel="noopener noreferrer"
      >
        Baca semua ulasan di Google Maps
      </a>
    )
  }
</section>
