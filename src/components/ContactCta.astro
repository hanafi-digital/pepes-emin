---
import { restaurant } from '../data/restaurant';
import { waLink } from '../lib/contact';

interface Props {
  variant: 'inline' | 'footer' | 'sticky';
  showDirections?: boolean;
}

const { variant, showDirections = true } = Astro.props;

const whatsappMessage = `Halo, saya ingin bertanya tentang ${restaurant.name}.`;
// TODO(owner): confirm a WhatsApp number before this button can appear.
const whatsappHref = waLink(restaurant.whatsapp, whatsappMessage);
const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl) && showDirections;
// TODO(owner): confirm a phone number before this button can appear.
const hasPhone = Boolean(restaurant.phone);
const showPhoneButton = variant !== 'sticky' && hasPhone;
const hasAnyButton = hasDirections || Boolean(whatsappHref) || showPhoneButton;

const wrapperClass =
  variant === 'sticky'
    ? 'fixed inset-x-0 bottom-0 z-50 flex gap-3 border-t border-stone-200/90 bg-white/95 backdrop-blur-md px-4 py-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-lg md:hidden'
    : variant === 'footer'
      ? 'flex flex-wrap gap-3'
      : 'flex flex-wrap gap-3';

const primaryButtonClass =
  variant === 'sticky'
    ? 'flex-1 inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-800 py-3 px-4 text-center text-xs sm:text-sm font-bold text-white shadow-xs transition-transform active:scale-95 hover:bg-emerald-900 min-h-[44px]'
    : 'inline-flex items-center justify-center gap-2 rounded-2xl bg-emerald-800 py-2.5 px-5 text-xs sm:text-sm font-bold text-white shadow-xs transition-transform active:scale-95 hover:bg-emerald-900 min-h-[44px]';

const secondaryButtonClass =
  variant === 'sticky'
    ? 'flex-1 inline-flex items-center justify-center gap-2 rounded-2xl border border-emerald-800 bg-emerald-50/50 py-3 px-4 text-center text-xs sm:text-sm font-bold text-emerald-900 transition-transform active:scale-95 min-h-[44px]'
    : variant === 'footer'
      ? 'underline underline-offset-2 text-xs sm:text-sm font-medium hover:text-white'
      : 'inline-flex items-center justify-center gap-2 rounded-2xl border border-stone-300 bg-white py-2.5 px-5 text-xs sm:text-sm font-bold text-stone-800 shadow-2xs transition-transform active:scale-95 hover:bg-stone-50 min-h-[44px]';
---

{hasAnyButton && (
  <div class={wrapperClass}>
    {
      hasDirections && (
        <a
          class={primaryButtonClass}
          href={restaurant.googleMapsDirectionsUrl!}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          Arah ke Lokasi
        </a>
      )
    }
    {
      whatsappHref && (
        <a class={secondaryButtonClass} href={whatsappHref} target="_blank" rel="noopener noreferrer">
          <svg class="h-4 w-4 shrink-0 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Chat WhatsApp
        </a>
      )
    }
    {
      showPhoneButton && (
        <a class={secondaryButtonClass} href={`tel:${restaurant.phone}`}>
          Telepon {restaurant.phone}
        </a>
      )
    }
  </div>
)}
