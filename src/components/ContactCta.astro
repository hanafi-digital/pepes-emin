---
import { restaurant } from '../data/restaurant';
import { waLink } from '../lib/contact';

interface Props {
  variant: 'inline' | 'footer' | 'sticky';
}

const { variant } = Astro.props;

const whatsappMessage = `Halo, saya ingin bertanya tentang ${restaurant.name}.`;
// TODO(owner): confirm a WhatsApp number before this button can appear.
const whatsappHref = waLink(restaurant.whatsapp, whatsappMessage);
const hasDirections = Boolean(restaurant.googleMapsDirectionsUrl);
// TODO(owner): confirm a phone number before this button can appear.
const hasPhone = Boolean(restaurant.phone);
const showPhoneButton = variant !== 'sticky' && hasPhone;
// Nothing to show yet (all contact fields still unconfirmed) — render
// nothing at all rather than an empty bar/strip.
const hasAnyButton = hasDirections || Boolean(whatsappHref) || showPhoneButton;

const wrapperClass =
  variant === 'sticky'
    ? 'fixed inset-x-0 bottom-0 z-50 mx-auto flex max-w-md gap-2 border-t border-gray-100 bg-white px-4 py-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-[0_-4px_12px_rgba(0,0,0,0.06)] md:hidden'
    : variant === 'footer'
      ? 'flex flex-wrap gap-3'
      : 'flex flex-wrap gap-3';

const primaryButtonClass =
  variant === 'sticky'
    ? 'flex-1 rounded-xl bg-emerald-600 py-3 px-4 text-center text-sm font-semibold text-white transition-transform active:scale-95 hover:bg-emerald-700'
    : 'rounded-xl bg-emerald-600 py-3 px-4 text-sm font-semibold text-white transition-transform active:scale-95 hover:bg-emerald-700';

const secondaryButtonClass =
  variant === 'sticky'
    ? 'flex-1 rounded-xl border border-emerald-600 py-3 px-4 text-center text-sm font-semibold text-emerald-700 transition-transform active:scale-95'
    : variant === 'footer'
      ? 'underline underline-offset-2 text-sm font-medium hover:text-white'
      : 'rounded-xl border border-emerald-600 py-3 px-4 text-sm font-semibold text-emerald-700 transition-transform active:scale-95 hover:bg-emerald-50';
---

{hasAnyButton && (
<div class={wrapperClass}>
  {
    hasDirections && (
      <a
        class={primaryButtonClass}
        href={restaurant.googleMapsDirectionsUrl!}
        target="_blank"
        rel="noopener noreferrer"
      >
        Arah ke lokasi
      </a>
    )
  }
  {
    whatsappHref && (
      <a class={secondaryButtonClass} href={whatsappHref} target="_blank" rel="noopener noreferrer">
        Hubungi via WhatsApp
      </a>
    )
  }
  {
    showPhoneButton && (
      <a class={secondaryButtonClass} href={`tel:${restaurant.phone}`}>
        Telepon {restaurant.phone}
      </a>
    )
  }
</div>
)}
