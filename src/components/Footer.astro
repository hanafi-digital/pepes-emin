---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);

const hasConfirmedHours = openingHours.some((h) => !h.closed && h.opens && h.closes);
const hoursSummary = hasConfirmedHours
  ? openingHours
      .filter((h) => !h.closed)
      .map((h) => `${DAY_LABEL_ID[h.day]} ${h.opens}–${h.closes}`)
      .join(', ')
  : 'Jam buka: segera diperbarui.';

const year = new Date().getFullYear();
---

<footer>
  <div class="container footer__grid">
    <address>
      {addressLines.map((line) => <span>{line}</span>)}
    </address>

    <p>{hoursSummary}</p>

    {restaurant.phone && (
      <p>
        Telepon: <a href={`tel:${restaurant.phone}`}>{restaurant.phone}</a>
      </p>
    )}

    {restaurant.whatsapp && (
      <p>
        WhatsApp: <a href={`https://wa.me/${restaurant.whatsapp}`}>{restaurant.whatsapp}</a>
      </p>
    )}

    {restaurant.googleMapsUrl && (
      <p>
        <a href={restaurant.googleMapsUrl} target="_blank" rel="noopener noreferrer">
          Lihat di Google Maps
        </a>
      </p>
    )}

    <p class="footer__notice">{restaurant.name} — website ini adalah prototype. &copy; {year}</p>
  </div>
</footer>

<style>
  footer {
    background: var(--leaf);
    color: var(--salt);
  }

  .footer__grid {
    padding-block: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    font-size: var(--fs-100);
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
  }

  a {
    color: var(--salt);
  }

  .footer__notice {
    margin-top: var(--sp-3);
  }
</style>
