---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';
import ContactCta from './ContactCta.astro';

const PLATFORM_LABEL: Record<string, string> = {
  instagram: 'Instagram',
  facebook: 'Facebook',
  youtube: 'YouTube',
  tripadvisor: 'Tripadvisor',
  tiktok: 'TikTok',
};

// Only accounts verified as belonging to this restaurant appear here — see
// docs/pepes-emin/research (workspace docs) for the verification criteria.
const verifiedSocialLinks = restaurant.socialLinks.filter((link) => link.verified);

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);

const hasConfirmedHours = openingHours.some((h) => !h.closed && h.opens && h.closes);
const hoursSummary = hasConfirmedHours
  ? openingHours
      .filter((h) => !h.closed)
      .map((h) => `${DAY_LABEL_ID[h.day]} ${h.opens}–${h.closes}`)
      .join(', ')
  : 'Jam buka: segera diperbarui.';

const year = new Date().getFullYear();
---

<footer class="bg-emerald-800 text-emerald-50">
  <div class="mx-auto flex max-w-4xl flex-col gap-3 px-4 py-8 text-sm">
    <address class="not-italic flex flex-col">
      {addressLines.map((line) => <span>{line}</span>)}
    </address>

    <p class="text-emerald-100">{hoursSummary}</p>

    <div class="pt-1">
      <ContactCta variant="footer" />
    </div>

    {restaurant.googleMapsUrl && (
      <p>
        <a
          class="underline underline-offset-2 hover:text-white"
          href={restaurant.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Lihat di Google Maps
        </a>
      </p>
    )}

    {
      verifiedSocialLinks.length > 0 && (
        <p class="flex gap-3">
          {verifiedSocialLinks.map((link) => (
            <a
              class="underline underline-offset-2 hover:text-white"
              href={link.url}
              target="_blank"
              rel="noopener noreferrer me"
            >
              {PLATFORM_LABEL[link.platform] ?? link.platform}
            </a>
          ))}
        </p>
      )
    }

    <p class="mt-3 text-xs text-emerald-200">
      {restaurant.name} — website ini adalah prototype. &copy; {year}
    </p>
  </div>
</footer>
