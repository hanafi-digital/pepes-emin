---
interface Props {
  src: string;
  title: string;
  aspectRatio?: string;
  minHeight?: string;
  label: string;
}

const { src, title, aspectRatio = '16/9', minHeight = '200px', label } = Astro.props;
---

<div
  class="lazy-embed relative bg-gray-100"
  data-lazy-embed
  data-src={src}
  data-title={title}
  data-label={label}
  style={`aspect-ratio:${aspectRatio};min-height:${minHeight}`}
>
  <noscript>
    <a
      class="absolute inset-0 flex items-center justify-center bg-emerald-800 text-white underline"
      href={src}
      target="_blank"
      rel="noopener noreferrer"
    >
      {label}
    </a>
  </noscript>
</div>

<script is:inline>
  document.querySelectorAll("[data-lazy-embed]").forEach(function(b){function ins(){if(b.dataset.done)return;b.dataset.done="1";var f=document.createElement("iframe");f.src=b.dataset.src;f.title=b.dataset.title;f.loading="lazy";f.referrerPolicy="no-referrer-when-downgrade";f.sandbox="allow-scripts allow-same-origin allow-popups";f.style.cssText="width:100%;height:100%;border:0";var t=setTimeout(fb,8000);f.onload=function(){clearTimeout(t)};f.onerror=fb;b.appendChild(f);function fb(){if(b.dataset.fell)return;b.dataset.fell="1";var a=document.createElement("a");a.href=b.dataset.src;a.target="_blank";a.rel="noopener noreferrer";a.textContent=b.dataset.label;a.style.cssText="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#065f46;color:#fff;text-decoration:underline";b.appendChild(a)}}if("IntersectionObserver"in window){var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){ins();io.unobserve(b)}})},{rootMargin:"200px"});io.observe(b)}else ins()});
</script>
