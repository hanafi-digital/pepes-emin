---
import MenuCard from './MenuCard.astro';
import Button from './Button.astro';
import { withBase } from '../lib/url';
import { menu } from '../data/menu';

const featuredItems = menu.flatMap((category) =>
  category.items
    .filter((item) => item.isFeatured)
    .map((item) => ({ ...item, categoryName: category.name }))
);
---

<section id="menu" class="py-12 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
          <span>Pilihan Terfavorit</span>
        </div>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-stone-900">
          Menu Andalan RM H. Emin
        </h2>
        <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-xl leading-relaxed">
          Pilihan hidangan pepes khas dan lauk pauk Sunda paling digemari pengunjung, disajikan hangat lengkap dengan bumbu rempah melimpah.
        </p>
      </div>

      <div class="hidden sm:block shrink-0">
        <Button href={withBase('/menu')} variant="secondary" class="shadow-sm">
          <span>Lihat Semua Menu &amp; Harga</span>
          <svg class="h-4 w-4 text-emerald-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </Button>
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
      {featuredItems.map((item) => (
        <MenuCard item={item} categoryName={item.categoryName} />
      ))}
    </div>

    <!-- Bottom Notice & Mobile Action -->
    <div class="mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-3xl border border-stone-200/80 bg-white/90 p-5 sm:p-6 shadow-sm">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 font-bold text-base">
          📋
        </div>
        <div>
          <span class="font-bold text-stone-900 text-sm">Tersedia Puluhan Menu Masakan Sunda</span>
          <p class="text-xs sm:text-sm text-stone-500">Pepes jambal, ayam bakar, sate maranggi, sayur asem, sambal terasi, dan aneka minuman.</p>
        </div>
      </div>
      <div class="sm:hidden">
        <Button href={withBase('/menu')} class="w-full">
          Buka Daftar Menu Lengkap
        </Button>
      </div>
    </div>
  </div>
</section>
