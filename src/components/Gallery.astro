---
import { Image } from 'astro:assets';

import pepesJambalImg from '../assets/hero-placeholder.jpg';
import sateMaranggiImg from '../assets/sate-maranggi.jpg';
import suasanaImg from '../assets/suasana-restoran.jpg';
import dapurImg from '../assets/dapur-tungku.jpg';
import bakakakAyamImg from '../assets/bakakak-ayam.jpg';
import sayurAsemImg from '../assets/sayur-asem.jpg';
import minumanSegarImg from '../assets/minuman-segar.jpg';

const galleryItems = [
  {
    image: pepesJambalImg,
    title: 'Pepes Jambal Roti',
    category: 'Menu Utama',
    desc: 'Ikan jambal roti berdaging tebal dibalut bumbu rempah kuning gurih di atas daun pisang bakar.',
    spanClass: 'sm:col-span-2 lg:col-span-2',
    aspectClass: 'aspect-[4/3] sm:aspect-[16/10]',
  },
  {
    image: dapurImg,
    title: 'Tungku Kayu Bakar Tradisional',
    category: 'Dapur Otentik',
    desc: 'Proses pengukusan tumpukan pepes menggunakan tungku tanah liat dan kayu bakar alami khas Walahar.',
    spanClass: 'sm:col-span-1 lg:col-span-1',
    aspectClass: 'aspect-[4/3] sm:aspect-square',
  },
  {
    image: sateMaranggiImg,
    title: 'Sate Maranggi Sapi',
    category: 'Sate Khas',
    desc: 'Daging sapi empuk berbumbu ketumbar manis gurih dengan sambal kecap cabai rawit pedas segar.',
    spanClass: 'sm:col-span-1 lg:col-span-1',
    aspectClass: 'aspect-[4/3] sm:aspect-square',
  },
  {
    image: suasanaImg,
    title: 'Suasana Santap Bersama Keluarga',
    category: 'Ruang Makan',
    desc: 'Tempat makan asri beraksen saung bambu alami dengan semilir angin sejuk Walahar.',
    spanClass: 'sm:col-span-2 lg:col-span-2',
    aspectClass: 'aspect-[4/3] sm:aspect-[16/10]',
  },
  {
    image: bakakakAyamImg,
    title: 'Bakakak Ayam Panggang',
    category: 'Olahan Ayam',
    desc: 'Ayam utuh panggang bumbu kecap manis gurih beraroma arang dengan daun pisang dan lalapan segar.',
    spanClass: 'sm:col-span-1 lg:col-span-1',
    aspectClass: 'aspect-[4/3] sm:aspect-square',
  },
  {
    image: sayurAsemImg,
    title: 'Sayur Asem & Sambel Terasi',
    category: 'Sayur & Sambal',
    desc: 'Kuah sayur asem hangat segar berpadu dengan ulekan cobek sambel terasi pedas mantap.',
    spanClass: 'sm:col-span-1 lg:col-span-1',
    aspectClass: 'aspect-[4/3] sm:aspect-square',
  },
  {
    image: minumanSegarImg,
    title: 'Es Kelapa Muda & Es Jeruk',
    category: 'Pelepas Dahaga',
    desc: 'Kesegaran air kelapa muda dingin dan perasan jeruk manis alami pelepas dahaga setelah santap.',
    spanClass: 'sm:col-span-1 lg:col-span-1',
    aspectClass: 'aspect-[4/3] sm:aspect-square',
  },
];
---

<section id="galeri" class="py-12 sm:py-16 lg:py-24 bg-white/60 border-y border-stone-200/70 backdrop-blur-xs">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6 mb-10">
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-900">
          <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span>
          <span>Galeri Foto &amp; Suasana</span>
        </div>
        <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-stone-900">
          Intip Kelezatan &amp; Kehangatan Warung
        </h2>
        <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-xl leading-relaxed">
          Mulai dari kepulan asap tungku kayu bakar tradisional hingga kehangatan suasana santap siang bersama keluarga tercinta.
        </p>
      </div>

      <div class="inline-flex items-center gap-2 text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200/80 rounded-2xl px-4 py-2.5">
        <span>📸</span>
        <span>Dokumentasi Kuliner Walahar</span>
      </div>
    </div>

    <!-- Gallery Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-5">
      {
        galleryItems.map((item) => (
          <div class={`group relative overflow-hidden rounded-3xl border border-stone-200/80 bg-stone-900 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-xl ${item.spanClass}`}>
            <div class={`w-full overflow-hidden ${item.aspectClass}`}>
              <Image
                src={item.image}
                alt={item.title}
                width={800}
                height={600}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/85 via-stone-950/20 to-transparent pointer-events-none"></div>

            <!-- Top Category Pill -->
            <div class="absolute top-4 left-4">
              <span class="inline-block rounded-full bg-black/50 px-3 py-1 text-[11px] font-bold text-amber-300 backdrop-blur-md border border-white/10 shadow-xs">
                {item.category}
              </span>
            </div>

            <!-- Bottom Content Caption -->
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-base sm:text-lg font-bold text-white leading-snug">
                {item.title}
              </h3>
              <p class="mt-1 text-xs text-stone-300 line-clamp-2 leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
