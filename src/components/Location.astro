---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';
import OpenStatusBadge from './OpenStatusBadge.astro';
import ContactCta from './ContactCta.astro';

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);
---

<section id="lokasi" class="py-12 sm:py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-900">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span>
        <span>Kunjungi Kami</span>
      </div>
      <h2 class="mt-3 text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-stone-900">
        Lokasi &amp; Jam Operasional
      </h2>
      <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-xl leading-relaxed">
        Singgah untuk bersantap siang hangat di kawasan Bendungan Walahar, Karawang dengan akses tol yang mudah.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10 lg:items-stretch">
      <!-- Left Column: Details & Schedule -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <!-- Address & Status Card -->
        <div class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-sm transition-all hover:shadow-md">
          <div class="mb-4">
            <OpenStatusBadge />
          </div>

          <div class="flex items-start gap-3.5">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-800 text-lg shadow-2xs">
              📍
            </div>
            <div>
              <h3 class="text-sm font-extrabold text-stone-900 uppercase tracking-wide text-[11px] text-stone-400">
                Alamat Rumah Makan
              </h3>
              <address class="not-italic text-sm sm:text-base font-bold text-stone-800 mt-1 leading-snug">
                {addressLines.map((line) => <span class="block">{line}</span>)}
              </address>
              {restaurant.landmark && (
                <p class="mt-2.5 text-xs font-bold text-amber-900 bg-amber-50 border border-amber-200/80 rounded-xl px-3 py-1 inline-block">
                  Patokan: {restaurant.landmark}
                </p>
              )}
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-stone-100 text-xs text-stone-500 leading-relaxed">
            <span class="font-bold text-stone-700">Rute Kendaraan:</span> Dapat diakses mudah dari Gerbang Tol Karawang Timur maupun Karawang Barat arah Klari / Walahar.
          </div>
        </div>

        <!-- Hours Table Card -->
        <div class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-sm transition-all hover:shadow-md">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-extrabold text-stone-900 flex items-center gap-2">
              <svg class="h-4 w-4 text-emerald-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>Jadwal Buka Mingguan</span>
            </h3>
            <span class="text-[11px] font-semibold text-stone-400">Waktu Indonesia Barat (WIB)</span>
          </div>

          <table data-hours-table class="w-full border-collapse text-xs sm:text-sm">
            <caption class="sr-only">Jam buka RM Pepes Jambal H. Emin</caption>
            <thead>
              <tr class="border-b border-stone-200 text-stone-400 text-left text-[11px] font-bold uppercase tracking-wider">
                <th scope="col" class="py-2.5 pr-2">Hari</th>
                <th scope="col" class="py-2.5 text-right">Jam Operasional</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              {
                openingHours.map((h) => (
                  <tr data-day={h.day} class="transition-colors hover:bg-stone-50/80">
                    <th scope="row" class="py-2.5 pr-2 text-left font-semibold text-stone-800">
                      {DAY_LABEL_ID[h.day]}
                    </th>
                    <td class="py-2.5 text-right tabular-nums font-semibold text-stone-700">
                      {h.closed || !h.opens || !h.closes ? (
                        <span class="inline-block rounded-full bg-rose-50 border border-rose-200 px-2.5 py-0.5 text-xs font-bold text-rose-700">Libur / Tutup</span>
                      ) : (
                        <span class="inline-block rounded-full bg-emerald-50 border border-emerald-200/80 px-2.5 py-0.5 text-xs font-bold text-emerald-900">
                          {h.opens} – {h.closes}
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div>
          <slot name="contact"><ContactCta variant="inline" showDirections={false} /></slot>
        </div>
      </div>

      <!-- Right Column: Interactive Map (Flush Alignment with Left Column) -->
      <div class="flex flex-col h-full min-h-[440px] lg:min-h-0 lg:col-span-7">
        <div class="flex flex-col h-full overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-md">
          <!-- Top Bar Above Map with Arah ke Lokasi Button -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-100 bg-gradient-to-r from-stone-50 to-emerald-50/30 px-5 py-3.5 shrink-0">
            <div class="flex items-center gap-2">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-600"></span>
              </span>
              <span class="text-xs sm:text-sm font-extrabold text-stone-800">
                Peta Lokasi Google Maps
              </span>
            </div>

            <div class="flex items-center gap-2.5">
              {restaurant.googleMapsDirectionsUrl && (
                <a
                  href={restaurant.googleMapsDirectionsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-emerald-800 to-emerald-900 px-4 py-2 text-xs font-bold text-white shadow-sm shadow-emerald-900/20 transition-all hover:from-emerald-700 hover:to-emerald-800 active:scale-95"
                >
                  <svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                  </svg>
                  <span>Arah ke Lokasi</span>
                </a>
              )}
              {restaurant.googleMapsUrl && (
                <a
                  href={restaurant.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rounded-xl border border-stone-300 bg-white px-3 py-2 text-xs font-semibold text-stone-700 transition-colors hover:bg-stone-50 shadow-2xs"
                  title="Buka di tab baru Google Maps"
                >
                  Layar Penuh &nearr;
                </a>
              )}
            </div>
          </div>

          <div class="relative flex-1 w-full min-h-[360px] lg:min-h-0 flex flex-col">
            <slot name="map" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  tr[data-today='true'] {
    background-color: #ecfdf5 !important;
  }
  tr[data-today='true'] th {
    font-weight: 800 !important;
    color: #065f46 !important;
  }
  tr[data-today='true'] th::after {
    content: ' (Hari Ini)';
    font-weight: 700;
    font-size: 0.75rem;
    color: #059669;
  }
</style>
