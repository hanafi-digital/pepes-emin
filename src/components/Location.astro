---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';
import OpenStatusBadge from './OpenStatusBadge.astro';
import ContactCta from './ContactCta.astro';

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);
---

<section id="lokasi" class="mx-auto flex max-w-4xl flex-col gap-4 px-4 py-6">
  <h2 class="text-xl font-bold tracking-tight text-gray-900">Lokasi &amp; Jam Buka</h2>

  <div class="overflow-hidden rounded-xl border border-gray-100">
    <slot name="map" />
  </div>

  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <div class="flex flex-col gap-3">
      <OpenStatusBadge />

      <address class="not-italic flex flex-col text-sm text-gray-500">
        {addressLines.map((line) => <span>{line}</span>)}
        {restaurant.landmark && <span>{restaurant.landmark}</span>}
      </address>
    </div>

    <table data-hours-table class="w-full border-collapse text-sm">
      <caption class="sr-only">Jam buka RM Pepes Jambal H. Emin</caption>
      <thead>
        <tr>
          <th scope="col" class="border-b border-gray-100 py-1 pr-2 text-left font-semibold text-gray-900">
            Hari
          </th>
          <th scope="col" class="border-b border-gray-100 py-1 text-left font-semibold text-gray-900">
            Jam
          </th>
        </tr>
      </thead>
      <tbody>
        {
          openingHours.map((h) => (
            <tr data-day={h.day}>
              <th scope="row" class="border-b border-gray-100 py-1 pr-2 text-left font-normal text-gray-900">
                {DAY_LABEL_ID[h.day]}
              </th>
              <td class="border-b border-gray-100 py-1 tabular-nums text-gray-500">
                {h.closed || !h.opens || !h.closes ? 'Tutup' : `${h.opens}–${h.closes}`}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div>
    <slot name="contact"><ContactCta variant="inline" /></slot>
  </div>
</section>

<style>
  tr[data-today='true'] th {
    font-weight: 600;
  }

  tr[data-today='true'] th::after {
    content: ' (hari ini)';
    font-weight: 400;
    color: #6b7280;
  }
</style>
