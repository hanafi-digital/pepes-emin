---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';
import OpenStatusBadge from './OpenStatusBadge.astro';
import ContactCta from './ContactCta.astro';

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);
---

<section id="lokasi" class="section container location">
  <h2>Lokasi &amp; Jam Buka</h2>

  <OpenStatusBadge />

  <address>
    {addressLines.map((line) => <span>{line}</span>)}
    {restaurant.landmark && <span>{restaurant.landmark}</span>}
  </address>

  <table data-hours-table>
    <caption>Jam buka RM Pepes Jambal H. Emin</caption>
    <thead>
      <tr>
        <th scope="col">Hari</th>
        <th scope="col">Jam</th>
      </tr>
    </thead>
    <tbody>
      {
        openingHours.map((h) => (
          <tr data-day={h.day}>
            <th scope="row">{DAY_LABEL_ID[h.day]}</th>
            <td>{h.closed || !h.opens || !h.closes ? 'Tutup' : `${h.opens}–${h.closes}`}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="location__embed">
    <slot name="map" />
  </div>

  <div class="location__contact">
    <slot name="contact"><ContactCta variant="inline" /></slot>
  </div>
</section>

<style>
  .location {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  address {
    font-style: normal;
    display: flex;
    flex-direction: column;
  }

  table {
    border-collapse: collapse;
    width: 100%;
    max-width: 24rem;
  }

  caption {
    text-align: left;
    font-size: var(--fs-100);
    margin-bottom: var(--sp-2);
  }

  th,
  td {
    text-align: left;
    padding: var(--sp-1) var(--sp-2);
    border-bottom: 1px solid var(--rule);
    font-variant-numeric: tabular-nums;
  }

  tr[data-today='true'] th,
  tr[data-today='true'] td {
    font-weight: 600;
  }

  tr[data-today='true'] th::after {
    content: ' (hari ini)';
    font-weight: 400;
    font-size: var(--fs-100);
  }
</style>
