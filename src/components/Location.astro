---
import { restaurant } from '../data/restaurant';
import { openingHours, DAY_LABEL_ID } from '../data/opening-hours';
import OpenStatusBadge from './OpenStatusBadge.astro';
import ContactCta from './ContactCta.astro';

const { address } = restaurant;
const addressLines = [
  address.street,
  `${address.village}, ${address.district ?? ''}`.replace(/, $/, ''),
  `${address.city}, ${address.province}${address.postalCode ? ` ${address.postalCode}` : ''}`,
].filter(Boolean);
---

<section id="lokasi" class="py-12 sm:py-16 lg:py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-amber-800">
        <span class="h-1 w-5 rounded-full bg-amber-600"></span>
        <span>Kunjungi Kami</span>
      </div>
      <h2 class="mt-2 text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-stone-900">
        Lokasi &amp; Jam Operasional
      </h2>
      <p class="mt-2 text-sm sm:text-base text-stone-600 max-w-xl">
        Singgah untuk makan siang hangat di kawasan wisata Bendungan Walahar, Karawang.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-10 lg:items-stretch">
      <!-- Left Column: Details & Schedule -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <!-- Address & Status Card -->
        <div class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-xs">
          <div class="mb-4">
            <OpenStatusBadge />
          </div>

          <div class="flex items-start gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-bold text-stone-900">Alamat Lengkap:</h3>
              <address class="not-italic text-sm text-stone-600 mt-1 leading-snug">
                {addressLines.map((line) => <span class="block">{line}</span>)}
              </address>
              {restaurant.landmark && (
                <p class="mt-2 text-xs font-medium text-amber-800 bg-amber-50 rounded-lg px-2.5 py-1 inline-block">
                  Patokan: {restaurant.landmark}
                </p>
              )}
            </div>
          </div>

          <div class="mt-4 pt-4 border-t border-stone-100 text-xs text-stone-500">
            <span class="font-semibold text-stone-700">Rute Kendaraan:</span> Dapat diakses mudah dari Gerbang Tol Karawang Timur maupun Karawang Barat arah Klari/Walahar.
          </div>
        </div>

        <!-- Hours Table Card -->
        <div class="rounded-3xl border border-stone-200/80 bg-white p-6 shadow-xs">
          <h3 class="text-sm font-bold text-stone-900 mb-3 flex items-center gap-2">
            <svg class="h-4 w-4 text-emerald-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            Jadwal Buka Mingguan
          </h3>

          <table data-hours-table class="w-full border-collapse text-xs sm:text-sm">
            <caption class="sr-only">Jam buka RM Pepes Jambal H. Emin</caption>
            <thead>
              <tr class="border-b border-stone-200 text-stone-500 text-left text-xs font-semibold">
                <th scope="col" class="py-2 pr-2">Hari</th>
                <th scope="col" class="py-2 text-right">Jam Operasional</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
              {
                openingHours.map((h) => (
                  <tr data-day={h.day} class="transition-colors hover:bg-stone-50/80">
                    <th scope="row" class="py-2 pr-2 text-left font-normal text-stone-800">
                      {DAY_LABEL_ID[h.day]}
                    </th>
                    <td class="py-2 text-right tabular-nums font-medium text-stone-600">
                      {h.closed || !h.opens || !h.closes ? (
                        <span class="rounded-md bg-stone-100 px-2 py-0.5 text-xs text-stone-500">Tutup</span>
                      ) : (
                        `${h.opens} – ${h.closes} WIB`
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div>
          <slot name="contact"><ContactCta variant="inline" /></slot>
        </div>
      </div>

      <!-- Right Column: Interactive Map (Stretches to match left column height) -->
      <div class="flex flex-col h-full min-h-[420px] lg:min-h-0 lg:col-span-7">
        <div class="flex flex-col h-full overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-md">
          <div class="flex items-center justify-between border-b border-stone-100 bg-stone-50/80 px-5 py-3 shrink-0">
            <span class="text-xs font-semibold text-stone-700 flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              Peta Lokasi Google Maps
            </span>
            {restaurant.googleMapsUrl && (
              <a
                href={restaurant.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-emerald-800 hover:text-emerald-950 underline underline-offset-2"
              >
                Buka Layar Penuh
              </a>
            )}
          </div>
          <div class="relative flex-1 w-full min-h-[360px] lg:min-h-0 flex flex-col">
            <slot name="map" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  tr[data-today='true'] {
    background-color: #ecfdf5 !important;
  }
  tr[data-today='true'] th {
    font-weight: 700 !important;
    color: #065f46 !important;
  }
  tr[data-today='true'] th::after {
    content: ' (Hari Ini)';
    font-weight: 500;
    font-size: 0.75rem;
    color: #059669;
  }
</style>
