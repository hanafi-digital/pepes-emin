---
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import { withBase } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import bricolageFontUrl from '../assets/fonts/bricolage-grotesque-latin-variable.woff2?url';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Reserves space so the sticky mobile contact bar doesn't cover the footer. */
  hasStickyContact?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType,
  noindex = false,
  hasStickyContact = false,
}: Props = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {/* Only Bricolage Grotesque is preloaded: it's what Hero's visible
        text (the LCP candidate) actually uses. Newsreader only appears
        further down the page, so preloading it too would just compete
        with the hero image for early bandwidth without helping LCP. */}
    <link rel="preload" href={bricolageFontUrl} as="font" type="font/woff2" crossorigin />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class={hasStickyContact ? 'has-sticky-cta' : undefined}>
    <a href="#main" class="skip-link">Langsung ke konten utama</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
