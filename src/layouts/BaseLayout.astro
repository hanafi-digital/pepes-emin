---
import '../styles/tailwind.css';
import Seo from '../components/Seo.astro';
import { withBase } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Reserves space so the sticky mobile contact bar doesn't cover the footer. */
  hasStickyContact?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType,
  noindex = false,
  hasStickyContact = false,
}: Props = Astro.props;
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class="bg-gray-50">
    <a href="#main" class="skip-link">Langsung ke konten utama</a>
    <div class:list={['mx-auto max-w-md bg-gray-50 min-h-screen shadow-xl', { 'pb-20': hasStickyContact }]}>
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
